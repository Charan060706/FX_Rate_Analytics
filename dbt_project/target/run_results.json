`.`fx_marts`.`fct_fx_rates`\n)\n\nselect \n  date,\n  base,target,rate,prev_rate,\n  case \n     when prev_rate is null then 0.0\n     else round(((rate-prev_rate)/prev_rate)*100 , 4)\n\n  end as daily_return_pct\n\nfrom base_rates", "relation_name": "`currency-tracker-507607`.`fx_marts`.`fct_fx_daily_returns`", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-11T09:51:53.967254Z", "completed_at": "2026-09-11T09:51:53.972400Z"}, {"name": "execute", "started_at": "2026-09-11T09:51:53.973579Z", "completed_at": "2026-09-11T09:51:58.115246Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 4.151180744171143, "adapter_response": {"_message": "CREATE TABLE (17.5k rows, 581.3 KiB processed)", "code": "CREATE TABLE", "rows_affected": 17508, "bytes_processed": 595272, "bytes_billed": 10485760, "location": "US", "project_id": "currency-tracker-507607", "job_id": "67be0928-c13b-4f91-be9a-8151fb638cb7", "slot_ms": 2550}, "message": "CREATE TABLE (17.5k rows, 581.3 KiB processed)", "failures": null, "unique_id": "model.fx_pipeline.fct_fx_rolling_volataility", "compiled": true, "compiled_code": "\n\nwith returns as (\n    select * from `currency-tracker-507607`.`fx_marts`.`fct_fx_daily_returns`\n)\n\nselect\n  date,base,target,rate,daily_return_pct,\n  round(STDDEV(daily_return_pct) over(\n    PARTITION BY base,target\n    order by date \n    rows between 6 preceding and current row\n  ),4) as rolling_volataility_7d,\n\n  round(stddev(daily_return_pct) over (\n        partition by base, target\n        order by date\n        rows between 29 preceding and current row\n    ), 4) as rolling_volatility_30d\n\nfrom returns", "relation_name": "`currency-tracker-507607`.`fx_marts`.`fct_fx_rolling_volataility`", "batch_results": null, "overload_results": null}], "elapsed_time": 15.546277523040771, "args": {"exclude_resource_types": [], "maximum_seed_size_mib": 1, "require_resource_names_without_spaces": tr